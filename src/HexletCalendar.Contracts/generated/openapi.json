{
  "openapi": "3.0.0",
  "info": {
    "title": "Toolchain compatibility probe",
    "version": "0.0.0"
  },
  "tags": [],
  "paths": {
    "/probe": {
      "get": {
        "operationId": "getProbe",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeItem"
                }
              }
            }
          },
          "409": {
            "description": "The request conflicts with the current state of the server.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeProblem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProbeDetail": {
        "type": "object",
        "required": [
          "note"
        ],
        "properties": {
          "note": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ProbeItem": {
        "type": "object",
        "required": [
          "id",
          "createdAt",
          "detail"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 2147483647
          },
          "createdAt": {
            "$ref": "#/components/schemas/ProbeTimestamp"
          },
          "detail": {
            "$ref": "#/components/schemas/ProbeDetail"
          }
        }
      },
      "ProbeProblem": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ProbeTimestamp": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
        "format": "date-time"
      }
    }
  }
}
